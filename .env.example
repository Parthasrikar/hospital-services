# API Server Configuration
API_PORT=3000

# Database Connection String
DATABASE_URL="mongodb://localhost:27019/hospital_db?replicaSet=rs0&directConnection=true"

# JWT & Cookie Configuration
JWT_ACCESS_SECRET="your_access_secret_key_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your_refresh_secret_key_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="your_cookie_secret_key_change_in_production"

# OAuth Configuration (Google)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

